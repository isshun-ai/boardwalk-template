{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boardwalk.dev/schema/intent.schema.json",
  "title": ".events/intents/<delivery_id>.json (DESIGN \u00a77a, register C4)",
  "type": "object",
  "required": [
    "delivery_id",
    "agent",
    "event_ids",
    "status",
    "created_at",
    "attempts"
  ],
  "properties": {
    "delivery_id": {
      "type": "string",
      "pattern": "^dlv_[a-z0-9]+$"
    },
    "agent": {
      "$ref": "post.schema.json#/$defs/agent"
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^evt_[a-z0-9]+$"
      }
    },
    "status": {
      "enum": [
        "pending",
        "dispatched",
        "deferred",
        "started",
        "done",
        "failed",
        "undelivered"
      ]
    },
    "created_at": {
      "$ref": "post.schema.json#/properties/time"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "action",
          "outcome"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          }
        }
      }
    },
    "run_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^run_[a-z0-9]+$"
        }
      ]
    },
    "deferred_until": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "post.schema.json#/properties/time"
        }
      ]
    }
  }
}
