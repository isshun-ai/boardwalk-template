{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boardwalk.dev/schema/claim.schema.json",
  "title": ".claims/<issue>.json (DESIGN \u00a76)",
  "type": "object",
  "required": [
    "issue",
    "agent",
    "run",
    "generation",
    "token",
    "claimed_at",
    "lease_until"
  ],
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "agent": {
      "$ref": "post.schema.json#/$defs/agent"
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "128 random bits per acquisition; every holder action presents it with the generation"
    },
    "claimed_at": {
      "$ref": "post.schema.json#/properties/time"
    },
    "lease_until": {
      "$ref": "post.schema.json#/properties/time"
    },
    "handoff": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "to",
            "why",
            "at"
          ],
          "properties": {
            "to": {
              "$ref": "post.schema.json#/$defs/agent"
            },
            "why": {
              "type": "string"
            },
            "at": {
              "$ref": "post.schema.json#/properties/time"
            }
          }
        }
      ]
    },
    "closing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "reason",
            "at"
          ],
          "properties": {
            "reason": {
              "enum": [
                "completed",
                "not_planned"
              ]
            },
            "comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "$ref": "post.schema.json#/properties/time"
            }
          }
        }
      ]
    },
    "observed": {
      "description": "The Issue lifecycle seen at acquisition; a reopen the count does not cover releases the claim",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "issue_updated_at",
            "reopens"
          ],
          "properties": {
            "issue_updated_at": {
              "$ref": "post.schema.json#/properties/time"
            },
            "reopens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  },
  "not": {
    "properties": {
      "handoff": {
        "type": "object"
      },
      "closing": {
        "type": "object"
      }
    },
    "required": [
      "handoff",
      "closing"
    ]
  }
}
