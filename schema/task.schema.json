{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boardwalk.dev/schema/task.schema.json",
  "title": "The yaml block at the top of a task Issue (DESIGN §6; approvals deferred by register C1)",
  "type": "object",
  "properties": {
    "kind": { "const": "task" },
    "project": { "$ref": "post.schema.json#/$defs/agent" },
    "discovered_from": { "$ref": "ref.schema.json" },
    "when": { "$ref": "post.schema.json#/$defs/offsetTime" },
    "triggers": { "$ref": "post.schema.json#/$defs/triggers" },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": { "$ref": "#/$defs/text" },
        "source_revision": { "$ref": "#/$defs/text" },
        "tried": { "$ref": "#/$defs/text" },
        "next_action": { "$ref": "#/$defs/text" },
        "acceptance": { "$ref": "#/$defs/text" },
        "blockers": { "$ref": "#/$defs/text" }
      }
    }
  },
  "not": { "required": ["blocked_by"] },
  "$defs": {
    "text": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
  }
}
